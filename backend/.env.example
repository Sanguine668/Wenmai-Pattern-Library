# 本地配置示例（复制为 .env 后按需修改）
# 默认数据库为项目根目录下的 data/wenmai.db
# DATABASE_URL=sqlite:///../data/wenmai.db

# 演示账号名称（无密码，仅作游客兜底）
DEMO_USERNAME=demo

# 首次启动管理员密码（可选）：
# 不设置时自动生成随机密码并写入 data/admin-initial-password.txt
# WENMAI_ADMIN_PASSWORD=change-me-before-first-start

# JWT 密钥（可选）：
# 不设置时自动生成并写入 data/.jwt_secret
# WENMAI_JWT_SECRET=please-change-to-a-long-random-string
